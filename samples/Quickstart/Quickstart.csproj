<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Project references rather than package references, so that a clone of this repository runs as it is. A consumer
    would do the same thing with `dotnet add package ParaTactus.NET` and `ParaTactus.Bass` once they are published.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\ParaTactus\ParaTactus.csproj" />
    <ProjectReference Include="..\..\ParaTactus.Bass\ParaTactus.Bass.csproj" />
  </ItemGroup>
</Project>
