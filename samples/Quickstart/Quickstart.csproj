<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BASS ships its native libraries per platform, and a framework-dependent build with no runtime identifier does
         not copy them, so the decoder cannot load one and hangs against whatever it finds instead. Pinning a RID is
         what makes this run; on another platform change it, or pass one to dotnet run. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Project references rather than package references, so that a clone of this repository runs as it is. A consumer
    would do the same thing with `dotnet add package ParaTactus.NET` and `ParaTactus.Bass` once they are published.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\ParaTactus\ParaTactus.csproj" />
    <ProjectReference Include="..\..\ParaTactus.Bass\ParaTactus.Bass.csproj" />
  </ItemGroup>
</Project>
